                                <Border Style="{StaticResource TweakCardStyle}" Tag="settings accent color"><StackPanel><TextBlock Text="Accent Color" Style="{StaticResource CardTitleTextStyle}"/><ComboBox x:Name="AccentColorCombo" Margin="0,14,0,0" Width="180" Style="{StaticResource ComboBoxStyleDark}" SelectionChanged="AccentColorCombo_SelectionChanged"><ComboBoxItem Content="Violet"/><ComboBoxItem Content="Rose"/><ComboBoxItem Content="Cyan"/><ComboBoxItem Content="Emerald"/></ComboBox></StackPanel></Border>
                                <Border Style="{StaticResource TweakCardStyle}" Tag="settings scale text ui"><StackPanel><TextBlock Text="Text Scaling" Style="{StaticResource CardTitleTextStyle}"/><Slider x:Name="TextScaleSlider" Minimum="0.85" Maximum="1.25" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1" Margin="0,14,0,0" ValueChanged="TextScaleSlider_ValueChanged"/><TextBlock x:Name="TextScaleValueText" Text="100%" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource TweakCardStyle}" Tag="settings density compact comfortable"><StackPanel><TextBlock Text="UI Density" Style="{StaticResource CardTitleTextStyle}"/><ComboBox x:Name="DensityCombo" Margin="0,14,0,0" Width="180" Style="{StaticResource ComboBoxStyleDark}" SelectionChanged="DensityCombo_SelectionChanged"><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Compact"/><ComboBoxItem Content="Comfortable"/></ComboBox></StackPanel></Border>
                                <Border Style="{StaticResource TweakCardStyle}" Tag="settings theme dark obsidian"><StackPanel><TextBlock Text="Theme Selector" Style="{StaticResource CardTitleTextStyle}"/><ComboBox x:Name="ThemeCombo" Margin="0,14,0,0" Width="180" Style="{StaticResource ComboBoxStyleDark}" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBoxItem Content="Midnight"/><ComboBoxItem Content="Obsidian"/><ComboBoxItem Content="Deep Violet"/></ComboBox></StackPanel></Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="ActionOverlay" Grid.ColumnSpan="2" Background="#88000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Padding="22" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <TextBlock x:Name="ActionOverlayText" Text="Applying tweak..." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="10" Margin="0,16,0,0"/>
                    <TextBlock Text="Please wait" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="WarningInfoOverlay" Grid.ColumnSpan="2" Background="#88000000" Visibility="Collapsed" MouseLeftButtonDown="WarningInfoOverlay_MouseLeftButtonDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Padding="22" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="#9A6D18" BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="WarningInfoCard_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Warning Details" Foreground="#F8C54F" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock x:Name="WarningInfoText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,12,0,0"/>
                    <Button Content="Close" Width="96" Margin="0,16,0,0" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="CloseWarningInfoOverlay_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="StartupOverlay" Grid.ColumnSpan="2" Visibility="Visible">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#030209" Offset="0"/>
                    <GradientStop Color="#120823" Offset="0.45"/>
                    <GradientStop Color="#1D0D3A" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid IsHitTestVisible="False">
                <Ellipse Width="760" Height="760" Fill="#432A81" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-280,-220,0"/>
                <Ellipse Width="660" Height="660" Fill="#2A1954" Opacity="0.22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-210,0,0,-250"/>
            </Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <TextBlock x:Name="StartupWelcomeText" Text="Welcome to Tulip Tweaks" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="38" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StartupStatusText" Text="Preparing your workspace..." Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <ProgressBar x:Name="StartupProgressBar" Minimum="0" Maximum="100" Height="10" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
